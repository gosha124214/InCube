<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppInCube.View.Pages.Favorites.MakeProgramm.MakeProgramm"
             Title="Созданные">
    <Grid RowDefinitions="*, Auto" Padding="20">
        <!-- Остальной контент (можно добавить позже) -->
        <VerticalStackLayout Grid.Row="0" />

        <!-- Кнопка внизу страницы с обработчиком события -->
        <Button Grid.Row="1" Text="Создать программу" 
            HorizontalOptions="FillAndExpand" 
            VerticalOptions="End" 
            Clicked="OnCreateProgramButtonClicked" />
    </Grid>
</ContentPage>
