<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppInCube.View.Pages.Favorites.ProgrammsInProcess.UnderPagesInProcess.UnderPagesInProcess"
             Title="Детали программы">
    <ScrollView>
        <StackLayout Padding="10">
            <Label Text="{Binding NameBird}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Content}" FontSize="18" />
            <Label Text="{Binding IdBirdInMySQL, StringFormat='Id птицы: {0}'}" FontSize="20"/>
            <Label Text="{Binding IdProgramInMySQL, StringFormat='Id программы: {0}'}" FontSize="20"/>
            <Label Text="{Binding DaysUntilHatching, StringFormat='Дней до вылупления: {0}'}" FontSize="18" />
            <Label Text="{Binding DateTimeValue, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}" FontSize="18" />
            <Image Source="{Binding ImageSource}" HeightRequest="200" Aspect="AspectFit" />

            <Frame x:Name="MessageFrame" IsVisible="False" BackgroundColor="Green" CornerRadius="5" Padding="10">
                <Label x:Name="MessageLabel" Text="" TextColor="White"/>
            </Frame>

            <!-- Таймеры -->
            <Label x:Name="TimeStartProgramm" FontSize="18" TextColor="Black" />
            <Label x:Name="TotalTimeRemainingLabel" FontSize="18" TextColor="Black" />
            <Label x:Name="NextDayTimeRemainingLabel" FontSize="18" TextColor="Black" />
            <Label x:Name="NextPhaseTimeRemainingLabel" FontSize="18" TextColor="Black" />

            <!-- Заголовок таблицы и данные в одной таблице -->
            <Label Text="Программы:" FontSize="20" FontAttributes="Bold" Margin="0,20,0,10"/>

            <!-- Данные -->
            <CollectionView x:Name="DopInfoPartyCollectionView"
                            ItemsSource="{Binding DopInfoParty}" 
                            Margin="0,10,0,0">
                <CollectionView.Header>
                    <Grid BackgroundColor="Red" Padding="5" RowSpacing="0" ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Text="День" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0" />
                        <Label Text="Мин.Т" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="1" />
                        <Label Text="Мкс.Т" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="2" />
                        <Label Text="Мин.Вл" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="3" />
                        <Label Text="Мкс.Вл" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="4" />
                        <Label Text="Мин.О" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="5" />
                        <Label Text="Мкс.О" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="6" />
                        <Label Text="Охлаж" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="7" />
                        <Label Text="Мин.В" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="8" />
                        <Label Text="Мкс.В" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="9" />
                        <Label Text="Действие" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="10" />
                        <Label Text="Сост" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="11" />
                    </Grid>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Black" StrokeThickness="1">
                            <Grid Padding="0" RowSpacing="0" ColumnSpacing="0" BackgroundColor="Green">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Text="{Binding Day}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0" Padding="5" />
                                <Label Text="{Binding MinTemperature, StringFormat='{0}°C'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="1" Padding="5" />
                                <Label Text="{Binding MaxTemperature, StringFormat='{0}°C'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="2" Padding="5" />
                                <Label Text="{Binding MinHumidity, StringFormat='{0}%'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="3" Padding="5" />
                                <Label Text="{Binding MaxHumidity, StringFormat='{0}%'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="4" Padding="5" />
                                <Label Text="{Binding MinАmountTurn, StringFormat='{0}',TargetNullValue='0'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="5" Padding="5" />
                                <Label Text="{Binding MaxАmountTurn, StringFormat='{0}',TargetNullValue='0'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="6" Padding="5" />
                                <Label Text="{Binding АmountCooling, StringFormat='{0}к',TargetNullValue='0к'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="7" Padding="5" />
                                <Label Text="{Binding MinTimeCooling, StringFormat='{0:mm}м',TargetNullValue='00м'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="8" Padding="5" />
                                <Label Text="{Binding MaxTimeCooling, StringFormat='{0:mm}м',TargetNullValue='00м'}" FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="9" Padding="5" />
                                <Button Text="Записать" 
                                    TextColor="White" 
                                    Clicked="OnCompletedButtonClicked" 
                                    CommandParameter="{Binding .}" 
                                    FontSize="9" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="10" Padding="5">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BackgroundColor" Value="Gray" />
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Setter Property="Text" Value="Не доступно" />

                                            <Style.Triggers>
                                                <!-- Если статус NotRecorded (1) -->
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="1">
                                                    <Setter Property="BackgroundColor" Value="Blue" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Text" Value="Записать" />
                                                </DataTrigger>

                                                <!-- Если статус 2 -->
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="2">
                                                    <Setter Property="BackgroundColor" Value="#7CFC00" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Text" Value="Изменить" />
                                                </DataTrigger>

                                                <!-- Если статус 3 -->
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="3">
                                                    <Setter Property="BackgroundColor" Value="#7CFC00" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Text" Value="Изменить" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Статус с ПРАВИЛЬНЫМИ триггерами на основе Status -->
                                <Label FontSize="9" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" 
                                   Grid.Column="11" 
                                   Padding="5">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="Text" Value="-" />
                                            <Setter Property="BackgroundColor" Value="LightGray" />
                                            <Setter Property="TextColor" Value="DarkGray" />

                                            <Style.Triggers>
                                                <!-- Если статус Waiting (0) -->
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="0">
                                                    <Setter Property="Text" Value="В ожидании" />
                                                    <Setter Property="BackgroundColor" Value="LightGray" />
                                                    <Setter Property="TextColor" Value="DarkGray" />
                                                </DataTrigger>

                                                <!-- Если статус NotRecorded (1) -->
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="1">
                                                    <Setter Property="Text" Value="Не записано" />
                                                    <Setter Property="BackgroundColor" Value="LightPink" />
                                                    <Setter Property="TextColor" Value="DarkRed" />
                                                </DataTrigger>

                                                <!-- Если статус Completed (2) -->
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="2">
                                                    <Setter Property="Text" Value="Выполнено" />
                                                    <Setter Property="BackgroundColor" Value="LightGreen" />
                                                    <Setter Property="TextColor" Value="DarkGreen" />
                                                </DataTrigger>

                                                <!-- Если статус Available (3) -->
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="3">
                                                    <Setter Property="Text" Value="Не выполнено" />
                                                    <Setter Property="BackgroundColor" Value="LightBlue" />
                                                    <Setter Property="TextColor" Value="DarkBlue" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Форма для добавления записи (ОБНОВЛЕНА) -->
            <Frame x:Name="AddRecordFrame" IsVisible="False" BackgroundColor="LightGray" Padding="10" Margin="0,20,0,0">
                <StackLayout>
                    <Label Text="Добавить запись:" FontSize="16" FontAttributes="Bold" />

                    <!-- Выбор периода дней -->
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="5" VerticalOptions="Center">
                        <Label Text="Период:" Grid.Column="0" FontSize="12" VerticalOptions="Center"/>

                        <Label x:Name="SelectedDayFromLabel" Text="1" 
           Grid.Column="1" FontSize="12" FontAttributes="Bold"
           HorizontalOptions="Center" VerticalOptions="Center"/>

                        <Label Text="до" Grid.Column="2" FontSize="12" VerticalOptions="Center"/>

                        <Label x:Name="SelectedDayToLabel" Text="1" 
           Grid.Column="3" FontSize="12" FontAttributes="Bold"
           HorizontalOptions="Center" VerticalOptions="Center"/>

                        <!-- Кнопка для изменения конечного дня -->
                        <Button Text="..." Grid.Column="4" FontSize="10" Padding="5,0"
            Clicked="OnChangeEndDayClicked" WidthRequest="30"
            ToolTipProperties.Text="Изменить конечный день"/>

                        <!-- НОВАЯ КНОПКА: Автопериод -->
                        <Button Text="Автопериод" Grid.Column="5" FontSize="10" Padding="5,0"
            Clicked="OnAutoPeriodClicked" WidthRequest="70"/>
                    </Grid>

                    <Label Text="Автопериод найдет дни с одинаковыми параметрами в исходной программе" 
                           FontSize="10" TextColor="Gray" Margin="0,5,0,0"/>

                    <!-- Основная форма ввода -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                          ColumnSpacing="10" RowSpacing="5" Margin="0,10,0,0">
                        <Label Text="День:" Grid.Row="0" Grid.Column="0" FontSize="12"/>
                        <Label x:Name="SelectedDayLabel" Text="" Grid.Row="0" Grid.Column="1" FontSize="12" FontAttributes="Bold"/>

                        <Label Text="Мин.Т:" Grid.Row="1" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MinTempEntry" Grid.Row="1" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Мкс.Т:" Grid.Row="2" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MaxTempEntry" Grid.Row="2" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Мин.Вл:" Grid.Row="3" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MinHumidityEntry" Grid.Row="3" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Мкс.Вл:" Grid.Row="4" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MaxHumidityEntry" Grid.Row="4" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Мин.О:" Grid.Row="5" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MinTurnEntry" Grid.Row="5" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Мкс.О:" Grid.Row="6" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MaxTurnEntry" Grid.Row="6" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Охлаж:" Grid.Row="7" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="CoolingAmountEntry" Grid.Row="7" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Мин.В:" Grid.Row="8" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MinCoolingTimeEntry" Grid.Row="8" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>

                        <Label Text="Мкс.В:" Grid.Row="9" Grid.Column="0" FontSize="12"/>
                        <Entry x:Name="MaxCoolingTimeEntry" Grid.Row="9" Grid.Column="1" FontSize="12" Keyboard="Numeric"/>
                    </Grid>

                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Button Text="Сохранить" Clicked="OnSaveRecordClicked" BackgroundColor="Green" TextColor="White" Margin="0,0,10,0"/>
                        <Button Text="Отмена" Clicked="OnCancelRecordClicked" BackgroundColor="Red" TextColor="White"/>
                    </StackLayout>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>