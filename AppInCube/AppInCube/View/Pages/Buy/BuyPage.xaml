<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppInCube.View.Pages.Buy.BuyPage"
             Title="Тест уведомлений v12"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- ЗАГОЛОВОК -->
            <Label Text="🔔 Тестирование уведомлений" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   TextColor="#512BD4"/>

            <Label Text="Каждое уведомление содержит подробное описание" 
                   FontSize="14" 
                   HorizontalOptions="Center"
                   TextColor="Gray"
                   Margin="0,0,0,20"/>

            <!-- 1. ПРОСТОЕ -->
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <VerticalStackLayout Spacing="8" Padding="15">
                    <Label Text="✅ Простое уведомление" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <Label Text="Появится сразу, с описанием типа" 
                           FontSize="12"/>
                    <Button Text="Отправить сейчас" 
                            Clicked="OnSimpleNotificationClicked"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>

            <!-- 2. С ЗАДЕРЖКОЙ -->
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <VerticalStackLayout Spacing="8" Padding="15">
                    <Label Text="⏰ С задержкой 5 секунд" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <Label Text="Появится через 5 сек, с временем отправки" 
                           FontSize="12"/>
                    <Button Text="Запланировать" 
                            Clicked="OnDelayedNotificationClicked"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>

            <!-- 3. ПОВТОРЯЮЩЕЕСЯ -->
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <VerticalStackLayout Spacing="8" Padding="15">
                    <Label Text="🔄 Повторяющееся" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <Label Text="Каждые 10 секунд, с информацией об интервале" 
                           FontSize="12"/>
                    <Button Text="Создать повторение" 
                            Clicked="OnRepeatingNotificationClicked"
                            BackgroundColor="#9C27B0"
                            TextColor="White"
                            HeightRequest="45"/>
                    <!-- В BuyPage.xaml добавьте: -->
                    <Button Text="⏹️ Остановить повторение" 
        Clicked="OnStopRepeatingClicked"
        Margin="0,10,0,0"
        BackgroundColor="#FF5252"
        TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- 4. С ПОДРОБНЫМ ТЕКСТОМ -->
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <VerticalStackLayout Spacing="8" Padding="15">
                    <Label Text="📄 С подробным описанием" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <Label Text="Длинный текст с детальной информацией" 
                           FontSize="12"/>
                    <Button Text="Отправить подробное" 
                            Clicked="OnLongNotificationClicked"
                            BackgroundColor="#3F51B5"
                            TextColor="White"
                            HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>

            <!-- 5. ТЕСТ ВСЕХ -->
            <Frame CornerRadius="10" Padding="0" HasShadow="True" 
                   BorderColor="#4CAF50" BackgroundColor="#E8F5E9">
                <VerticalStackLayout Spacing="8" Padding="15">
                    <Label Text="⚡ Тест всех уведомлений" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <Label Text="Отправит 4 уведомления последовательно" 
                           FontSize="12"/>
                    <Button Text="Запустить полный тест" 
                            Clicked="OnTestAllClicked"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"/>
                </VerticalStackLayout>
            </Frame>

            <!-- 6. РАЗРЕШЕНИЯ -->
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <VerticalStackLayout Spacing="8" Padding="15">
                    <Label Text="🔐 Разрешения" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <Label Text="Запрос прав на показ уведомлений" 
                           FontSize="12"/>
                    <Button Text="Запросить разрешения" 
                            Clicked="OnRequestPermissionClicked"
                            BackgroundColor="#607D8B"
                            TextColor="White"
                            HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>

            <!-- 7. ОЧИСТКА -->
            <Frame CornerRadius="10" Padding="0" HasShadow="True">
                <VerticalStackLayout Spacing="8" Padding="15">
                    <Label Text="🗑️ Очистка" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <Label Text="Удалить все уведомления" 
                           FontSize="12"/>
                    <Button Text="Очистить всё" 
                            Clicked="OnClearAllClicked"
                            BackgroundColor="#F44336"
                            TextColor="White"
                            HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>
            <Button Text="Test Windows Notification" 
        Clicked="TestWindowsNotification_Clicked"
        Margin="0,20,0,0" />
            <!-- ИНФОРМАЦИЯ -->
            <Frame CornerRadius="10" Padding="15" BackgroundColor="#E3F2FD" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="5">
                    <Label Text="ℹ️ Как это работает" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="#1565C0"/>
                    <Label Text="• Каждое уведомление содержит описание" 
                           FontSize="12"/>
                    <Label Text="• В описании указано, какая кнопка его вызвала" 
                           FontSize="12"/>
                    <Label Text="• Добавлены пояснения о времени и типе" 
                           FontSize="12"/>
                    <Label Text="• Проверяйте системную шторку уведомлений" 
                           FontSize="12"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>